# Server-side Groq configuration.
# Configure GROQ_API_KEY as a secret in the Cloudflare Worker environment.
# Never use a VITE_ prefix or commit real credentials.
GROQ_API_KEY=

# Optional model override; defaults to openai/gpt-oss-20b
GROQ_MODEL=

# Enable specialist orchestration only with the exact value: true
DOOT_MULTI_AGENT=false
\n# Optional live web research. Configure as a server-side Worker secret.\n# Do not add this key to client-side VITE_ variables.\nTAVILY_API_KEY=\n